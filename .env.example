# Push Notification Keys
VAPID_PRIVATE_KEY=
VITE_VAPID_PUBLIC_KEY=

# Sanka Anime API Configuration (Ganti URL / IP jika terkena 403 Forbidden di Vercel)
# Default: https://www.sankavollerei.web.id/anime
# Jika di Vercel terkena Cloudflare 403, arahkan ke proxy / IP VPS Anda:
# Contoh: http://103.xxx.xxx.xxx:3000/anime atau https://worker-proxy.yourname.workers.dev/anime
SANKA_API_BASE=
# URL cadangan otomatis jika URL utama mengembalikan 403 atau error
SANKA_API_FALLBACK=
